FW_DB_PATH=/var/lib/feast-watch/mother.db
FW_LISTEN=:8443
FW_API_KEY=change-me

# The base URL agents are told to reach the mother on, scheme included.
#
# The mother serves plain HTTP and does not terminate TLS. Where TLS is wanted,
# put a reverse proxy in front and name the proxy here — a whole URL is the only
# shape that can describe a different host, port or path prefix, and the agent
# concatenates its paths straight onto this value.
#
#   FW_PUBLIC_URL=http://10.0.0.1:8443          direct, private network
#   FW_PUBLIC_URL=https://ops.feast.tr/watch    behind a TLS-terminating proxy
FW_PUBLIC_URL=http://10.0.0.1:8443

# Retired, honoured for one release as plain HTTP. FW_PUBLIC_ADDR was a bare
# host:port back when the scheme was derived from the mother's own certificate.
# FW_PUBLIC_ADDR=

# The mother compiles the fleet's binaries and serves them. Agents download from
# FW_PUBLIC_URL above and from nowhere else — they have no route off this
# network — so a version exists for the fleet exactly when it has been built
# here:
#
#   feast-watch build v1.5.0
#
# FW_BUILD_DIR=/var/lib/feast-watch/builds    the catalogue: built into, served from
# FW_SOURCE_DIR=/opt/feast-watch/src          build from a checkout on this host
# FW_SOURCE_URL=https://github.com/osman-yahya/feast-watch
#                                             otherwise the tag's source archive
#                                             is fetched from here — the one
#                                             address only this host resolves
# FW_RELEASE_POLL_INTERVAL=5m                 how often the catalogue is re-read
