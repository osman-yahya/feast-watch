FW_DB_PATH=/var/lib/feast-watch/mother.db
FW_LISTEN=:8443
FW_PUBLIC_ADDR=10.0.0.1:8443
FW_API_KEY=change-me
FW_DOWNLOADS_DIR=/var/lib/feast-watch/downloads
FW_TLS_CERT=
FW_TLS_KEY=
# Set to "true" only when FW_TLS_CERT is a self-signed certificate: the
# generated install script then writes TLS_SKIP_VERIFY=true into agent.conf,
# without which the installed agent cannot complete its TLS handshake.
FW_AGENT_TLS_SKIP_VERIFY=
