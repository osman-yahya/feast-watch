#!/usr/bin/env bash
# feast-watch agent installer — rendered by the mother per server token.
#
# The whole body lives in main(), invoked on the last line, because this script
# is consumed as `curl ... | sudo bash`: bash executes statements as they
# arrive, so a connection dropped mid-transfer would otherwise run a prefix of
# the installer — typically enabling a service whose binary was never written.
set -euo pipefail

MOTHER_URL={{.MotherURL}}
TOKEN={{.Token}}
SERVER_NAME="{{.ServerName}}"

# agent_arch maps `uname -m` onto the GOARCH the release assets are named with.
agent_arch() {
  local arch
  arch=$(uname -m)
  case "$arch" in
    x86_64) echo amd64 ;;
    aarch64|arm64) echo arm64 ;;
    *) echo "unsupported arch: $arch" >&2; return 1 ;;
  esac
}

# download_agent fetches the newest build this mother has compiled for this
# platform, and verifies it before it is allowed to become the binary.
#
# --fail is not optional: without it `curl -o` exits 0 on an HTTP 404 and writes
# the response body, so a missing asset installs an error page as the agent,
# chmod 0755, and the service respawns against it every 5 seconds. set -euo
# pipefail does not catch that — curl succeeded.
#
# The binary comes from the mother, on the same URL shape a release host used.
# It is the only address this host is asked to reach: an agent has no route off
# this network, so a binary from anywhere else would be one it could never
# fetch. If this 404s, nothing has been built on the mother yet — run
# `feast-watch build <version>` there.
download_agent() {
  local arch="$1" dest="$2"
  # This installer is bash + systemd, so the target is always Linux. The GOOS
  # is part of the asset name because releases also carry builds for other
  # operating systems, and an arch alone does not identify a runnable binary.
  local asset="feast-watch-agent-linux-$arch"
  local url="$MOTHER_URL/releases/latest/download/$asset"
  local tmp
  tmp=$(mktemp)
  # shellcheck disable=SC2064  # expand tmp now: it must be removed on any exit
  trap "rm -f '$tmp' '$tmp.sha256'" RETURN

  curl -fsSL "$url" -o "$tmp"
  curl -fsSL "$url.sha256" -o "$tmp.sha256"

  local want got
  want=$(cut -d' ' -f1 < "$tmp.sha256")
  got=$(sha256sum "$tmp" 2>/dev/null | cut -d' ' -f1 || shasum -a 256 "$tmp" | cut -d' ' -f1)
  if [ "$want" != "$got" ]; then
    echo "checksum mismatch for $asset: refusing to install" >&2
    return 1
  fi

  install -m 0755 "$tmp" "$dest"
}

# install_uninstaller puts the uninstaller on disk so a host being
# decommissioned can be cleaned without reaching the mother — which may be
# unreachable from a machine on its way out, or already retired itself. The
# manifest records what this installer touched, so a future uninstaller can
# clean a host installed by an older one.
install_uninstaller() {
  curl -fsSL "$MOTHER_URL/uninstall.sh" -o /usr/local/sbin/feast-watch-agent-uninstall
  chmod 0755 /usr/local/sbin/feast-watch-agent-uninstall

  cat > /etc/feast-watch/install-manifest <<EOF
# What this installer created. No secrets: the token lives in agent.conf.
installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
bin=/usr/local/bin/feast-watch-agent
conf=/etc/feast-watch/agent.conf
unit=/etc/systemd/system/feast-watch-agent.service
uninstaller=/usr/local/sbin/feast-watch-agent-uninstall
EOF
  chmod 0644 /etc/feast-watch/install-manifest
}

write_config() {
  mkdir -p /etc/feast-watch
  cat > /etc/feast-watch/agent.conf <<EOF
MOTHER_URL=$MOTHER_URL
TOKEN=$TOKEN
SERVER_NAME=$SERVER_NAME
EOF
  chmod 0600 /etc/feast-watch/agent.conf
}

install_service() {
  cat > /etc/systemd/system/feast-watch-agent.service <<'EOF'
[Unit]
Description=feast-watch agent
After=network-online.target

[Service]
ExecStart=/usr/local/bin/feast-watch-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now feast-watch-agent
}

main() {
  local arch
  arch=$(agent_arch)

  echo "-> downloading agent"
  download_agent "$arch" /usr/local/bin/feast-watch-agent

  echo "-> writing config"
  write_config

  echo "-> installing uninstaller"
  install_uninstaller

  echo "-> installing systemd service"
  install_service

  echo "feast-watch agent installed — server will appear online within seconds."
  echo "To remove it later: sudo feast-watch-agent-uninstall --purge"
}

main "$@"
